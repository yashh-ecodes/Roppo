# Copy to .env and fill in. Never commit real secrets.

# Long random string used to sign login tokens (required in production).
ROPPO_JWT_SECRET=replace-with-a-long-random-string
ROPPO_ENVIRONMENT=development

# Database (defaults to a local SQLite file when unset; docker-compose sets PostgreSQL).
# ROPPO_DATABASE_URL=postgresql+psycopg://roppo:password@localhost:5432/roppo
# POSTGRES_PASSWORD=choose-a-password

# Optional AI explanations via Claude. Leave empty to run rules-only.
# Users must also opt in under Profile & Settings before anything is sent.
ANTHROPIC_API_KEY=
ROPPO_LLM_MODEL=claude-opus-5-5

# Optional live job sources (official public job-board APIs), comma-separated board names.
ROPPO_GREENHOUSE_BOARDS=
ROPPO_LEVER_COMPANIES=

# One-click "Explore the demo" accounts with fictional data (for presentations).
ROPPO_DEMO_MODE=true

# Seed fictional, clearly labelled example jobs for demos.
ROPPO_SEED_SAMPLE_JOBS=true
